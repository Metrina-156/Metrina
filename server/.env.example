# Express Server Running Port
PORT=5000

# MongoDB Database Connection String
# For local testing: mongodb://localhost:27017/metrina
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/metrina?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/metrina

# Resend API Key (Get from https://resend.com)
# Example: re_A1B2c3D4_e5F6g7H8i9J0k1L2
RESEND_API_KEY=

# Agency Recipient Email Address
AGENCY_EMAIL=hello@metrina.dev

# Sender Name & Email Identifier (Domain must be verified in Resend, or use sandbox default)
SENDER_EMAIL=onboarding@resend.dev
CLIENT_NAME=Metrina

# CORS configuration: Allow client domain requests
CLIENT_URL=http://localhost:3000
